# Copy this file to .env and fill in your values. Never commit .env.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# true = return canned AI results, no API calls (works offline)
DEMO_MODE=true

# Only "mock" is supported: the 3 built-in fake stores (see README, "Why no real store?")
STORE_MODE=mock

# false = show real browser windows while searching (nice for local demos)
HEADLESS=true

# How many browser pages run at the same time
MAX_PARALLEL=4

# Live browser screenshots per second (per browser tile)
SCREENSHOT_FPS=2

# Server
HOST=127.0.0.1
PORT=8000
